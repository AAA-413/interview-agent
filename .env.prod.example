# ============================================================
# 生产环境配置模板 — 复制为 .env.prod 后填入真实值
# ============================================================

# ---- 数据库 ----
POSTGRES_PASSWORD=your_secure_db_password

# ---- Redis ----
REDIS_PASSWORD=your_secure_redis_password

# ---- MinIO 对象存储 ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_secure_minio_password
MINIO_BUCKET=interview-guide

# ---- JWT 认证 ----
JWT_SECRET_KEY=your_random_secret_key_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- LLM 服务（DeepSeek） ----
AI_BAILIAN_API_KEY=sk-your_deepseek_key
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com

# ---- Embedding 服务（DashScope，DeepSeek 不提供 Embedding API） ----
# 如果有 DashScope API key 填入，否则自动降级为哈希向量
DASHSCOPE_API_KEY=sk-your_dashscope_key
AI_EMBEDDING_API_KEY=

# ---- 搜索服务 ----
TAVILY_API_KEY=tvly-your_tavily_key
SEARCH_ENGINE=tavily

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://your-domain.com

# ---- 端口映射 ----
APP_PORT=8002
NGINX_PORT=80

# ---- 应用配置 ----
APP_INTERVIEW_FOLLOW_UP_COUNT=0
